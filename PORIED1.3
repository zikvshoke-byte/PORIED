-- [[ ULTRA-OPTIMIZED MOBILE UI ENGINE ]] --
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local PoriedUI = {}
PoriedUI.__index = PoriedUI

-- Быстрая микро-анимация для экономии CPU
local function FastTween(instance, properties, duration)
    duration = duration or 0.12
    local tween = TweenService:Create(instance, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), properties)
    tween:Play()
    return tween
end

function PoriedUI:CreateWindow(config)
    local WindowName = config.Name or "Mobile Menu"
    
    local TargetParent = (gethui and gethui()) or game:GetService("CoreGui")
    
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "PoriedMobileUI_" .. math.random(1000, 9999)
    ScreenGui.ResetOnSpawn = false
    ScreenGui.IgnoreGuiInset = true
    ScreenGui.Parent = TargetParent

    -- // ПЛАВАЮЩАЯ КНОПКА ОТКРЫТИЯ/ЗАКРЫТИЯ ДЛЯ ТЕЛЕФОНОВ // --
    local ToggleWidget = Instance.new("TextButton")
    ToggleWidget.Size = UDim2.new(0, 42, 0, 42)
    ToggleWidget.Position = UDim2.new(0.05, 0, 0.15, 0)
    ToggleWidget.BackgroundColor3 = Color3.fromRGB(25, 27, 34)
    ToggleWidget.Text = "UI"
    ToggleWidget.TextColor3 = Color3.fromRGB(0, 200, 255)
    ToggleWidget.TextSize = 14
    ToggleWidget.Font = Enum.Font.GothamBold
    ToggleWidget.Active = true
    ToggleWidget.Draggable = true
    
    local WidgetCorner = Instance.new("UICorner")
    WidgetCorner.CornerRadius = UDim.new(0, 10)
    WidgetCorner.Parent = ToggleWidget
    
    local WidgetStroke = Instance.new("UIStroke")
    WidgetStroke.Color = Color3.fromRGB(0, 200, 255)
    WidgetStroke.Thickness = 1.2
    WidgetStroke.Parent = ToggleWidget
    ToggleWidget.Parent = ScreenGui

    -- // ГЛАВНОЕ ОКНО // --
    local MainFrame = Instance.new("Frame")
    MainFrame.Size = UDim2.new(0, 480, 0, 310)
    MainFrame.Position = UDim2.new(0.5, -240, 0.5, -155)
    MainFrame.BackgroundColor3 = Color3.fromRGB(18, 20, 24)
    MainFrame.BorderSizePixel = 0
    MainFrame.ClipsDescendants = true
    MainFrame.Active = true

    local MainCorner = Instance.new("UICorner")
    MainCorner.CornerRadius = UDim.new(0, 8)
    MainCorner.Parent = MainFrame

    local MainStroke = Instance.new("UIStroke")
    MainStroke.Color = Color3.fromRGB(38, 42, 52)
    MainStroke.Thickness = 1
    MainStroke.Parent = MainFrame

    -- Логика скрытия по кнопке UI
    ToggleWidget.MouseButton1Click:Connect(function()
        MainFrame.Visible = not MainFrame.Visible
    end)

    -- // ВЕРХНЯЯ ПАНЕЛЬ (TITLE & DRAG) // --
    local TopBar = Instance.new("Frame")
    TopBar.Size = UDim2.new(1, 0, 0, 36)
    TopBar.BackgroundColor3 = Color3.fromRGB(24, 27, 33)
    TopBar.BorderSizePixel = 0
    TopBar.Parent = MainFrame

    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, -50, 1, 0)
    Title.Position = UDim2.new(0, 12, 0, 0)
    Title.BackgroundTransparency = 1
    Title.Text = WindowName
    Title.TextColor3 = Color3.fromRGB(240, 240, 240)
    Title.TextSize = 14
    Title.Font = Enum.Font.GothamBold
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Parent = TopBar

    local CloseBtn = Instance.new("TextButton")
    CloseBtn.Size = UDim2.new(0, 36, 0, 36)
    CloseBtn.Position = UDim2.new(1, -36, 0, 0)
    CloseBtn.BackgroundTransparency = 1
    CloseBtn.Text = "×"
    CloseBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
    CloseBtn.TextSize = 20
    CloseBtn.Font = Enum.Font.GothamBold
    CloseBtn.Parent = TopBar
    CloseBtn.MouseButton1Click:Connect(function() MainFrame.Visible = false end)

    -- Быстрое перемещение окна для мобильных экранов
    local dragging, dragInput, dragStart, startPos
    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    TopBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- // САЙДБАР С ВКЛАДКАМИ // --
    local TabSidebar = Instance.new("ScrollingFrame")
    TabSidebar.Size = UDim2.new(0, 120, 1, -36)
    TabSidebar.Position = UDim2.new(0, 0, 0, 36)
    TabSidebar.BackgroundColor3 = Color3.fromRGB(22, 24, 29)
    TabSidebar.BorderSizePixel = 0
    TabSidebar.ScrollBarThickness = 0
    TabSidebar.CanvasSize = UDim2.new(0, 0, 0, 0)
    TabSidebar.Parent = MainFrame

    local TabListLayout = Instance.new("UIListLayout")
    TabListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    TabListLayout.Padding = UDim.new(0, 2)
    TabListLayout.Parent = TabSidebar

    TabListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        TabSidebar.CanvasSize = UDim2.new(0, 0, 0, TabListLayout.AbsoluteContentSize.Y)
    end)

    -- // КОНТЕЙНЕР КОНТЕНТА // --
    local PagesContainer = Instance.new("Frame")
    PagesContainer.Size = UDim2.new(1, -125, 1, -42)
    PagesContainer.Position = UDim2.new(0, 123, 0, 39)
    PagesContainer.BackgroundTransparency = 1
    PagesContainer.Parent = MainFrame
    MainFrame.Parent = ScreenGui

    local WindowObj = { Tabs = {}, FirstTab = nil }

    function WindowObj:CreateTab(tabName)
        local TabBtn = Instance.new("TextButton")
        TabBtn.Size = UDim2.new(1, 0, 0, 32)
        TabBtn.BackgroundColor3 = Color3.fromRGB(22, 24, 29)
        TabBtn.BorderSizePixel = 0
        TabBtn.Text = tabName
        TabBtn.TextColor3 = Color3.fromRGB(150, 155, 165)
        TabBtn.TextSize = 12
        TabBtn.Font = Enum.Font.GothamMedium
        TabBtn.Parent = TabSidebar

        local TabIndicator = Instance.new("Frame")
        TabIndicator.Size = UDim2.new(0, 3, 1, 0)
        TabIndicator.BackgroundColor3 = Color3.fromRGB(0, 180, 255)
        TabIndicator.BorderSizePixel = 0
        TabIndicator.Visible = false
        TabIndicator.Parent = TabBtn

        local Page = Instance.new("ScrollingFrame")
        Page.Size = UDim2.new(1, 0, 1, 0)
        Page.BackgroundTransparency = 1
        Page.BorderSizePixel = 0
        Page.ScrollBarThickness = 2
        Page.ScrollBarImageColor3 = Color3.fromRGB(50, 55, 65)
        Page.Visible = false
        Page.CanvasSize = UDim2.new(0, 0, 0, 0)
        Page.Parent = PagesContainer

        local PageLayout = Instance.new("UIListLayout")
        PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
        PageLayout.Padding = UDim.new(0, 6)
        PageLayout.Parent = Page

        PageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            Page.CanvasSize = UDim2.new(0, 0, 0, PageLayout.AbsoluteContentSize.Y + 10)
        end)

        local function Select()
            for _, otherTab in pairs(WindowObj.Tabs) do
                otherTab.Page.Visible = false
                otherTab.Indicator.Visible = false
                otherTab.Button.TextColor3 = Color3.fromRGB(150, 155, 165)
                otherTab.Button.BackgroundColor3 = Color3.fromRGB(22, 24, 29)
            end
            Page.Visible = true
            TabIndicator.Visible = true
            TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            TabBtn.BackgroundColor3 = Color3.fromRGB(27, 30, 37)
        end

        TabBtn.MouseButton1Click:Connect(Select)
        local TabItem = { Button = TabBtn, Page = Page, Indicator = TabIndicator }
        table.insert(WindowObj.Tabs, TabItem)

        if not WindowObj.FirstTab then
            WindowObj.FirstTab = TabItem
            Select()
        end

        local TabMethods = {}

        -- // СЕКЦИЯ // --
        function TabMethods:CreateSection(text)
            local SectionLabel = Instance.new("TextLabel")
            SectionLabel.Size = UDim2.new(1, -6, 0, 20)
            SectionLabel.BackgroundTransparency = 1
            SectionLabel.Text = string.upper(text)
            SectionLabel.TextColor3 = Color3.fromRGB(0, 180, 255)
            SectionLabel.TextSize = 10
            SectionLabel.Font = Enum.Font.GothamBold
            SectionLabel.TextXAlignment = Enum.TextXAlignment.Left
            SectionLabel.Parent = Page
        end

        -- // КНОПКА // --
        function TabMethods:CreateButton(cfg)
            local Btn = Instance.new("TextButton")
            Btn.Size = UDim2.new(1, -6, 0, 32)
            Btn.BackgroundColor3 = Color3.fromRGB(27, 30, 38)
            Btn.Text = cfg.Name or "Button"
            Btn.TextColor3 = Color3.fromRGB(230, 230, 230)
            Btn.TextSize = 12
            Btn.Font = Enum.Font.GothamMedium
            Btn.AutoButtonColor = false
            
            local Corner = Instance.new("UICorner")
            Corner.CornerRadius = UDim.new(0, 5)
            Corner.Parent = Btn

            Btn.MouseButton1Click:Connect(function()
                FastTween(Btn, {BackgroundColor3 = Color3.fromRGB(0, 180, 255)}, 0.08)
                task.delay(0.08, function()
                    FastTween(Btn, {BackgroundColor3 = Color3.fromRGB(27, 30, 38)}, 0.12)
                end)
                if cfg.Callback then cfg.Callback() end
            end)
            Btn.Parent = Page
        end

        -- // ПЕРЕКЛЮЧАТЕЛЬ (TOGGLE) // --
        function TabMethods:CreateToggle(cfg)
            local state = cfg.Default or false
            local ToggleFrame = Instance.new("TextButton")
            ToggleFrame.Size = UDim2.new(1, -6, 0, 32)
            ToggleFrame.BackgroundColor3 = Color3.fromRGB(27, 30, 38)
            ToggleFrame.Text = ""
            ToggleFrame.AutoButtonColor = false

            local Corner = Instance.new("UICorner")
            Corner.CornerRadius = UDim.new(0, 5)
            Corner.Parent = ToggleFrame

            local TitleLabel = Instance.new("TextLabel")
            TitleLabel.Size = UDim2.new(1, -45, 1, 0)
            TitleLabel.Position = UDim2.new(0, 10, 0, 0)
            TitleLabel.BackgroundTransparency = 1
            TitleLabel.Text = cfg.Name or "Toggle"
            TitleLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
            TitleLabel.TextSize = 12
            TitleLabel.Font = Enum.Font.Gotham
            TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
            TitleLabel.Parent = ToggleFrame

            local Indicator = Instance.new("Frame")
            Indicator.Size = UDim2.new(0, 24, 0, 14)
            Indicator.Position = UDim2.new(1, -34, 0.5, -7)
            Indicator.BackgroundColor3 = state and Color3.fromRGB(0, 200, 120) or Color3.fromRGB(45, 49, 60)
            
            local IndCorner = Instance.new("UICorner")
            IndCorner.CornerRadius = UDim.new(1, 0)
            IndCorner.Parent = Indicator

            local Dot = Instance.new("Frame")
            Dot.Size = UDim2.new(0, 10, 0, 10)
            Dot.Position = state and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)
            Dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            
            local DotCorner = Instance.new("UICorner")
            DotCorner.CornerRadius = UDim.new(1, 0)
            DotCorner.Parent = Dot
            Dot.Parent = Indicator
            Indicator.Parent = ToggleFrame

            local function SetState(val)
                state = val
                FastTween(Indicator, {BackgroundColor3 = state and Color3.fromRGB(0, 200, 120) or Color3.fromRGB(45, 49, 60)})
                FastTween(Dot, {Position = state and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)})
                if cfg.Callback then cfg.Callback(state) end
            end

            ToggleFrame.MouseButton1Click:Connect(function() SetState(not state) end)
            ToggleFrame.Parent = Page
        end

        -- // СЛАЙДЕР // --
        function TabMethods:CreateSlider(cfg)
            local Min = cfg.Min or 0
            local Max = cfg.Max or 100
            local Def = math.clamp(cfg.Default or Min, Min, Max)
            local Value = Def

            local SliderFrame = Instance.new("Frame")
            SliderFrame.Size = UDim2.new(1, -6, 0, 42)
            SliderFrame.BackgroundColor3 = Color3.fromRGB(27, 30, 38)
            
            local Corner = Instance.new("UICorner")
            Corner.CornerRadius = UDim.new(0, 5)
            Corner.Parent = SliderFrame

            local TitleLabel = Instance.new("TextLabel")
            TitleLabel.Size = UDim2.new(1, -60, 0, 20)
            TitleLabel.Position = UDim2.new(0, 10, 0, 3)
            TitleLabel.BackgroundTransparency = 1
            TitleLabel.Text = cfg.Name or "Slider"
            TitleLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
            TitleLabel.TextSize = 12
            TitleLabel.Font = Enum.Font.Gotham
            TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
            TitleLabel.Parent = SliderFrame

            local ValueLabel = Instance.new("TextLabel")
            ValueLabel.Size = UDim2.new(0, 50, 0, 20)
            ValueLabel.Position = UDim2.new(1, -58, 0, 3)
            ValueLabel.BackgroundTransparency = 1
            ValueLabel.Text = tostring(Value)
            ValueLabel.TextColor3 = Color3.fromRGB(0, 180, 255)
            ValueLabel.TextSize = 12
            ValueLabel.Font = Enum.Font.GothamBold
            ValueLabel.TextXAlignment = Enum.TextXAlignment.Right
            ValueLabel.Parent = SliderFrame

            local Track = Instance.new("TextButton")
            Track.Size = UDim2.new(1, -20, 0, 8)
            Track.Position = UDim2.new(0, 10, 0, 26)
            Track.BackgroundColor3 = Color3.fromRGB(40, 44, 55)
            Track.Text = ""
            Track.AutoButtonColor = false
            
            local TrackCorner = Instance.new("UICorner")
            TrackCorner.CornerRadius = UDim.new(1, 0)
            TrackCorner.Parent = Track

            local Fill = Instance.new("Frame")
            local initPercent = (Def - Min) / (Max - Min)
            Fill.Size = UDim2.new(initPercent, 0, 1, 0)
            Fill.BackgroundColor3 = Color3.fromRGB(0, 180, 255)
            Fill.BorderSizePixel = 0
            
            local FillCorner = Instance.new("UICorner")
            FillCorner.CornerRadius = UDim.new(1, 0)
            FillCorner.Parent = Fill
            Fill.Parent = Track
            Track.Parent = SliderFrame

            local function UpdateSlider(inputPos)
                local percent = math.clamp((inputPos.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                Value = math.floor(Min + (Max - Min) * percent)
                Fill.Size = UDim2.new(percent, 0, 1, 0)
                ValueLabel.Text = tostring(Value)
                if cfg.Callback then cfg.Callback(Value) end
            end

            local sliding = false
            Track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = true
                    UpdateSlider(input.Position)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = false
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    UpdateSlider(input.Position)
                end
            end)

            SliderFrame.Parent = Page
        end

        -- // ВЫПАДАЮЩИЙ СПИСОК (DROPDOWN С ПОДДЕРЖКОЙ :Refresh) // --
        function TabMethods:CreateDropdown(cfg)
            local Options = cfg.Options or {}
            local Selected = Options[1] or "None"
            local DropdownExpanded = false

            local DropdownContainer = Instance.new("Frame")
            DropdownContainer.Size = UDim2.new(1, -6, 0, 34)
            DropdownContainer.BackgroundColor3 = Color3.fromRGB(27, 30, 38)
            DropdownContainer.ClipsDescendants = true
            
            local Corner = Instance.new("UICorner")
            Corner.CornerRadius = UDim.new(0, 5)
            Corner.Parent = DropdownContainer

            local TopBtn = Instance.new("TextButton")
            TopBtn.Size = UDim2.new(1, 0, 0, 34)
            TopBtn.BackgroundTransparency = 1
            TopBtn.Text = ""
            TopBtn.Parent = DropdownContainer

            local TitleLabel = Instance.new("TextLabel")
            TitleLabel.Size = UDim2.new(0.5, 0, 1, 0)
            TitleLabel.Position = UDim2.new(0, 10, 0, 0)
            TitleLabel.BackgroundTransparency = 1
            TitleLabel.Text = cfg.Name or "Dropdown"
            TitleLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
            TitleLabel.TextSize = 12
            TitleLabel.Font = Enum.Font.Gotham
            TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
            TitleLabel.Parent = TopBtn

            local SelectedLabel = Instance.new("TextLabel")
            SelectedLabel.Size = UDim2.new(0.5, -24, 1, 0)
            SelectedLabel.Position = UDim2.new(0.5, 0, 0, 0)
            SelectedLabel.BackgroundTransparency = 1
            SelectedLabel.Text = tostring(Selected)
            SelectedLabel.TextColor3 = Color3.fromRGB(0, 180, 255)
            SelectedLabel.TextSize = 12
            SelectedLabel.Font = Enum.Font.GothamMedium
            SelectedLabel.TextXAlignment = Enum.TextXAlignment.Right
            SelectedLabel.Parent = TopBtn

            local OptionList = Instance.new("Frame")
            OptionList.Size = UDim2.new(1, -10, 0, 0)
            OptionList.Position = UDim2.new(0, 5, 0, 36)
            OptionList.BackgroundTransparency = 1
            
            local OptLayout = Instance.new("UIListLayout")
            OptLayout.Padding = UDim.new(0, 3)
            OptLayout.Parent = OptionList
            OptionList.Parent = DropdownContainer

            local function RefreshOptions(newOptions)
                Options = newOptions or {}
                for _, child in ipairs(OptionList:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end
                
                for _, opt in ipairs(Options) do
                    local ItemBtn = Instance.new("TextButton")
                    ItemBtn.Size = UDim2.new(1, 0, 0, 26)
                    ItemBtn.BackgroundColor3 = Color3.fromRGB(34, 38, 48)
                    ItemBtn.Text = tostring(opt)
                    ItemBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
                    ItemBtn.TextSize = 11
                    ItemBtn.Font = Enum.Font.Gotham
                    
                    local ItemCorner = Instance.new("UICorner")
                    ItemCorner.CornerRadius = UDim.new(0, 4)
                    ItemCorner.Parent = ItemBtn

                    ItemBtn.MouseButton1Click:Connect(function()
                        Selected = opt
                        SelectedLabel.Text = tostring(Selected)
                        DropdownExpanded = false
                        FastTween(DropdownContainer, {Size = UDim2.new(1, -6, 0, 34)})
                        if cfg.Callback then cfg.Callback({Selected}) end
                    end)
                    ItemBtn.Parent = OptionList
                end
            end

            TopBtn.MouseButton1Click:Connect(function()
                DropdownExpanded = not DropdownExpanded
                local targetHeight = DropdownExpanded and (38 + (#Options * 29)) or 34
                FastTween(DropdownContainer, {Size = UDim2.new(1, -6, 0, targetHeight)})
            end)

            RefreshOptions(Options)
            DropdownContainer.Parent = Page

            return {
                Refresh = function(_, newList)
                    RefreshOptions(newList)
                end
            }
        end

        -- // ПОЛЕ ВВОДА (INPUT) // --
        function TabMethods:CreateInput(cfg)
            local InputFrame = Instance.new("Frame")
            InputFrame.Size = UDim2.new(1, -6, 0, 34)
            InputFrame.BackgroundColor3 = Color3.fromRGB(27, 30, 38)
            
            local Corner = Instance.new("UICorner")
            Corner.CornerRadius = UDim.new(0, 5)
            Corner.Parent = InputFrame

            local TitleLabel = Instance.new("TextLabel")
            TitleLabel.Size = UDim2.new(0.5, 0, 1, 0)
            TitleLabel.Position = UDim2.new(0, 10, 0, 0)
            TitleLabel.BackgroundTransparency = 1
            TitleLabel.Text = cfg.Name or "Input"
            TitleLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
            TitleLabel.TextSize = 12
            TitleLabel.Font = Enum.Font.Gotham
            TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
            TitleLabel.Parent = InputFrame

            local Box = Instance.new("TextBox")
            Box.Size = UDim2.new(0.45, -10, 0, 24)
            Box.Position = UDim2.new(0.55, 0, 0.5, -12)
            Box.BackgroundColor3 = Color3.fromRGB(36, 40, 50)
            Box.PlaceholderText = cfg.PlaceholderText or "Type..."
            Box.PlaceholderColor3 = Color3.fromRGB(120, 125, 135)
            Box.Text = ""
            Box.TextColor3 = Color3.fromRGB(255, 255, 255)
            Box.TextSize = 11
            Box.Font = Enum.Font.Gotham
            Box.ClearTextOnFocus = false
            
            local BoxCorner = Instance.new("UICorner")
            BoxCorner.CornerRadius = UDim.new(0, 4)
            BoxCorner.Parent = Box

            Box.FocusLost:Connect(function()
                if cfg.Callback then cfg.Callback(Box.Text) end
            end)

            Box.Parent = InputFrame
            InputFrame.Parent = Page
        end

        return TabMethods
    end

    return WindowObj
end

return PoriedUI
