    -- // ВСТРОЕННАЯ ВКЛАДКА "CONFIG" // --
    function WindowObj:CreateConfigTab()
        if WindowObj.ConfigTabCreated then return end
        WindowObj.ConfigTabCreated = true

        local ConfigTab = WindowObj:CreateTab("Config", 998)
        ConfigTab:CreateSection("Save Current Config", "SaveCurrentConfig")

        local newConfigName = ""
        local selectedConfigName = ""

        ConfigTab:CreateInput({
            Name = "Config Name",
            TransKey = "ConfigName",
            PlaceholderText = "e.g. Legit, Rage",
            Callback = function(txt)
                newConfigName = txt
            end
        })

        local function GetSavedConfigNames()
            local list = {}
            local seen = {}
            pcall(function()
                if isfolder and not isfolder("poried_configs") then makefolder("poried_configs") end
                if listfiles then
                    for _, file in ipairs(listfiles("poried_configs")) do
                        if file:sub(-5) == ".json" then
                            local fileName = file:match("([^/^\\]+)%.json$")
                            if fileName and not fileName:find("^poried_") and not seen[fileName] then
                                seen[fileName] = true
                                table.insert(list, fileName)
                            end
                        end
                    end
                end
            end)
            return list
        end

        ConfigTab:CreateButton({
            Name = "Save Current Config",
            TransKey = "SaveConfigBtn",
            Callback = function()
                if newConfigName == "" then return end
                
                local data = {
                    Toggles = {},
                    Sliders = {},
                    Dropdowns = {},
                    Overlay = WindowObj.OverlaySettings,
                    Binds = WindowObj:GetBindsData() -- БИНДЫ СОХРАНЯЮТСЯ ТОЛЬКО В КОНФИГЕ!
                }

                for _, t in ipairs(WindowObj.RegisteredToggles) do
                    data.Toggles[t.Name] = t.GetState()
                end
                for _, s in ipairs(WindowObj.RegisteredSliders) do
                    data.Sliders[s.Name] = s.GetValue()
                end
                for _, d in ipairs(WindowObj.RegisteredDropdowns) do
                    data.Dropdowns[d.Name] = d.GetValue()
                end

                pcall(function()
                    if isfolder and not isfolder("poried_configs") then makefolder("poried_configs") end
                    writefile("poried_configs/" .. newConfigName .. ".json", HttpService:JSONEncode(data))
                end)

                if WindowObj.ConfigDropdownObj then
                    WindowObj.ConfigDropdownObj:Refresh(GetSavedConfigNames())
                end
            end
        })

        ConfigTab:CreateSection("Manage Configs", "ManageConfigs")

        WindowObj.ConfigDropdownObj = ConfigTab:CreateDropdown({
            Name = "Select Config",
            TransKey = "SelectConfig",
            Options = GetSavedConfigNames(),
            Callback = function(selected)
                selectedConfigName = selected[1]
            end
        })

        ConfigTab:CreateButton({
            Name = "Load Selected Config",
            TransKey = "LoadConfigBtn",
            Callback = function()
                if selectedConfigName == "" then return end
                pcall(function()
                    if isfile and isfile("poried_configs/" .. selectedConfigName .. ".json") then
                        local content = readfile("poried_configs/" .. selectedConfigName .. ".json")
                        local data = HttpService:JSONDecode(content)
                        if data then
                            if data.Toggles then
                                for name, state in pairs(data.Toggles) do
                                    for _, t in ipairs(WindowObj.RegisteredToggles) do
                                        if t.Name == name then t.SetState(state) end
                                    end
                                end
                            end
                            if data.Sliders then
                                for name, val in pairs(data.Sliders) do
                                    for _, s in ipairs(WindowObj.RegisteredSliders) do
                                        if s.Name == name then s.SetValue(val) end
                                    end
                                end
                            end
                            if data.Dropdowns then
                                for name, val in pairs(data.Dropdowns) do
                                    for _, d in ipairs(WindowObj.RegisteredDropdowns) do
                                        if d.Name == name then d.SetValue(val) end
                                    end
                                end
                            end
                            if data.Overlay then
                                for k, v in pairs(data.Overlay) do
                                    WindowObj.OverlaySettings[k] = v
                                end
                            end
                            if data.Binds then
                                WindowObj:ClearAllBinds()
                                for _, b in ipairs(data.Binds) do
                                    WindowObj:SpawnBindButton(b.ToggleName, b.Label, b.ScaleX, b.OffsetX, b.ScaleY, b.OffsetY)
                                end
                            end
                        end
                    end
                end)
            end
        })

        ConfigTab:CreateButton({
            Name = "Delete Selected Config",
            TransKey = "DeleteConfigBtn",
            Callback = function()
                if selectedConfigName == "" then return end
                pcall(function()
                    if isfile and isfile("poried_configs/" .. selectedConfigName .. ".json") then
                        delfile("poried_configs/" .. selectedConfigName .. ".json")
                    end
                end)
                selectedConfigName = ""
                if WindowObj.ConfigDropdownObj then
                    WindowObj.ConfigDropdownObj:Refresh(GetSavedConfigNames())
                end
            end
        })
    end

    -- // БИНДЫ С СОХРАНЕНИЕМ ТОЛЬКО В КОНФИГАХ // --
    function WindowObj:GetBindsData()
        local bindsList = {}
        for _, b in ipairs(WindowObj.RegisteredBinds) do
            if b and b.Frame and b.Frame.Parent then
                local pos = b.Frame.Position
                table.insert(bindsList, {
                    ToggleName = tostring(b.ToggleName),
                    Label = tostring(b.Label),
                    ScaleX = tonumber(pos.X.Scale) or 0.1,
                    OffsetX = tonumber(pos.X.Offset) or 0,
                    ScaleY = tonumber(pos.Y.Scale) or 0.3,
                    OffsetY = tonumber(pos.Y.Offset) or 0
                })
            end
        end
        return bindsList
    end

    function WindowObj:ClearAllBinds()
        for _, b in ipairs(WindowObj.RegisteredBinds) do
            if b and b.Frame then b.Frame:Destroy() end
        end
        WindowObj.RegisteredBinds = {}
    end

    function WindowObj:SpawnBindButton(toggleName, labelText, posScaleX, posOffsetX, posScaleY, posOffsetY)
        local targetToggle = nil
        for _, t in ipairs(WindowObj.RegisteredToggles) do
            if t.Name == toggleName then
                targetToggle = t
                break
            end
        end

        if not targetToggle then return end

        local BindBtnFrame = Instance.new("Frame")
        BindBtnFrame.Name = "BindBtn_" .. labelText
        BindBtnFrame.Size = UDim2.new(0, 44, 0, 44)
        BindBtnFrame.Position = UDim2.new(
            posScaleX or 0.1, 
            posOffsetX or math.random(10, 80), 
            posScaleY or 0.3, 
            posOffsetY or math.random(10, 80)
        )
        BindBtnFrame.BackgroundColor3 = targetToggle.GetState() and Theme.Accent or Theme.MainBackground
        BindBtnFrame.BackgroundTransparency = 0.2
        BindBtnFrame.Parent = ScreenGui

        Instance.new("UICorner", BindBtnFrame).CornerRadius = UDim.new(1, 0)

        local BindStroke = Instance.new("UIStroke", BindBtnFrame)
        BindStroke.Color = Theme.Accent
        BindStroke.Thickness = 1.5

        local BindTextLabel = Instance.new("TextLabel")
        BindTextLabel.Size = UDim2.new(1, 0, 1, 0)
        BindTextLabel.BackgroundTransparency = 1
        BindTextLabel.Text = labelText:sub(1, 3)
        BindTextLabel.TextColor3 = targetToggle.GetState() and Color3.fromRGB(0, 0, 0) or Theme.Accent
        BindTextLabel.TextSize = 12
        BindTextLabel.Font = CurrentFontBold
        BindTextLabel.Parent = BindBtnFrame

        RegisterText(BindTextLabel, true)

        local bindObj = {
            ToggleName = toggleName,
            Label = labelText,
            Frame = BindBtnFrame,
            UpdateColor = function(col)
                BindStroke.Color = col
                if targetToggle.GetState() then BindBtnFrame.BackgroundColor3 = col end
            end
        }
        table.insert(WindowObj.RegisteredBinds, bindObj)

        MakeDraggableAndClickable(BindBtnFrame, BindTextLabel, function()
            targetToggle.Toggle()
            local newState = targetToggle.GetState()
            if newState then
                Tween(BindBtnFrame, 0.2, {BackgroundColor3 = Theme.Accent})
                Tween(BindTextLabel, 0.2, {TextColor3 = Color3.fromRGB(0, 0, 0)})
            else
                Tween(BindBtnFrame, 0.2, {BackgroundColor3 = Theme.MainBackground})
                Tween(BindTextLabel, 0.2, {TextColor3 = Theme.Accent})
            end
        end, nil)
    end

    function WindowObj:CreateBindsTab()
        if WindowObj.BindsTabCreated then return end
        WindowObj.BindsTabCreated = true

        local BindTab = WindowObj:CreateTab("Binds", 999)
        BindTab:CreateSection("Quick Action Binds", "QuickActionBinds")

        local selectedToggleName = ""
        local bindLabelText = "AIM"

        local DropdownObj = BindTab:CreateDropdown({
            Name = "Select Feature",
            TransKey = "SelectFeature",
            Options = WindowObj.RegisteredToggleNames,
            Callback = function(selected)
                selectedToggleName = selected[1]
            end
        })

        WindowObj.OnToggleAdded = function(newName)
            DropdownObj:Refresh(WindowObj.RegisteredToggleNames)
        end

        BindTab:CreateInput({
            Name = "Button Label (3 Letters)",
            TransKey = "ButtonLabel",
            PlaceholderText = "e.g. AIM, BHP, ESP",
            Callback = function(txt)
                if txt and #txt > 0 then
                    bindLabelText = txt:sub(1, 3):upper()
                end
            end
        })

        BindTab:CreateButton({
            Name = "Create Quick-Bind Button",
            TransKey = "CreateBindBtn",
            Callback = function()
                if selectedToggleName == "" then return end
                WindowObj:SpawnBindButton(selectedToggleName, bindLabelText)
            end
        })
    end

    -- Автоматические вызовы
    WindowObj:CreateCustomTab()
    WindowObj:CreateConfigTab()
    WindowObj:CreateBindsTab()

    return WindowObj
end

return PoriedUI
