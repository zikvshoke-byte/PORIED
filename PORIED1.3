            TrackCorner.Parent = SliderTrack

            local SliderFill = Instance.new("Frame")
            SliderFill.Size = UDim2.new(math.clamp((value - Min) / (Max - Min), 0, 1), 0, 1, 0)
            SliderFill.BackgroundColor3 = Theme.Accent

            local FillCorner = Instance.new("UICorner")
            FillCorner.CornerRadius = UDim.new(1, 0)
            FillCorner.Parent = SliderFill
            SliderFill.Parent = SliderTrack
            SliderTrack.Parent = Frame
            Frame.Parent = TabScroll

            local dragging = false
            local lastVal = value
            local function UpdateSlider(input)
                local pos = math.clamp((input.Position.X - SliderTrack.AbsolutePosition.X) / SliderTrack.AbsoluteSize.X, 0, 1)
                local newVal = math.floor(Min + (Max - Min) * pos)
                SliderFill.Size = UDim2.new(pos, 0, 1, 0)
                if newVal ~= lastVal then
                    lastVal = newVal
                    value = newVal
                    ValueText.Text = tostring(value)
                    Callback(value)
                end
            end

            SliderTrack.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    UpdateSlider(input)
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    UpdateSlider(input)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)

            ValueText.FocusLost:Connect(function()
                local num = tonumber(ValueText.Text)
                if num then
                    value = math.clamp(math.floor(num), Min, Max)
                    lastVal = value
                    ValueText.Text = tostring(value)
                    local pos = (value - Min) / (Max - Min)
                    Tween(SliderFill, 0.2, {Size = UDim2.new(pos, 0, 1, 0)})
                    Callback(value)
                else
                    ValueText.Text = tostring(value)
                end
            end)

            local sliderObj = {
                Name = Name,
                GetValue = function() return value end,
                SetValue = function(newVal)
                    value = math.clamp(newVal, Min, Max)
                    lastVal = value
                    ValueText.Text = tostring(value)
                    Tween(SliderFill, 0.2, {Size = UDim2.new((value - Min) / (Max - Min), 0, 1, 0)})
                    Callback(value)
                end,
                UpdateColor = function(col) 
                    SliderFill.BackgroundColor3 = col
                    ValueText.TextColor3 = col 
                end
            }
            table.insert(WindowObj.RegisteredSliders, sliderObj)
        end

