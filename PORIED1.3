            SecLabel.Text = (transKey and Translations[CurrentLang][transKey] or text):upper()
            SecLabel.TextColor3 = Theme.Accent
            SecLabel.TextSize = 11
            SecLabel.Font = CurrentFontBold
            SecLabel.TextXAlignment = Enum.TextXAlignment.Left
            SecLabel.BackgroundTransparency = 1
            SecLabel.Parent = SecFrame

            RegisterText(SecLabel, true, transKey, true)

            table.insert(WindowObj.RegisteredSections, SecLabel)
            return SecLabel
        end

        function TabObj:CreateToggle(options)
            options = options or {}
            local Name = options.Name or "Toggle"
            local Default = options.Default or false
            local Callback = options.Callback or function() end
            local state = Default

            local Frame = Instance.new("Frame")
            Frame.Size = UDim2.new(1, 0, 0, 42)
            Frame.BackgroundColor3 = Theme.ElementBackground
            Frame.BackgroundTransparency = Theme.ElementTransparency
            Frame.Parent = TabScroll

            Instance.new("UICorner", Frame).CornerRadius = Theme.CornerRadius
            local Stroke = Instance.new("UIStroke", Frame)
            Stroke.Color = Theme.GlassStroke
            Stroke.Transparency = Theme.GlassStrokeTransparency

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(1, -65, 1, 0)
            Label.Position = UDim2.new(0, 12, 0, 0)
            Label.Text = Name
            Label.TextColor3 = Theme.TextWhite
            Label.TextSize = 13
            Label.Font = CurrentFontMedium
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.BackgroundTransparency = 1
            Label.Parent = Frame

            RegisterText(Label, false)

            local SwitchBg = Instance.new("TextButton")
            SwitchBg.Size = UDim2.new(0, 42, 0, 22)
            SwitchBg.Position = UDim2.new(1, -50, 0.5, -11)
            SwitchBg.BackgroundColor3 = state and Theme.Accent or Color3.fromRGB(50, 55, 65)
            SwitchBg.Text = ""
            SwitchBg.AutoButtonColor = false
            SwitchBg.Parent = Frame

            Instance.new("UICorner", SwitchBg).CornerRadius = UDim.new(1, 0)

            local Knob = Instance.new("Frame")
            Knob.Size = UDim2.new(0, 18, 0, 18)
            Knob.Position = state and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
            Knob.BackgroundColor3 = Theme.TextWhite
            Knob.Parent = SwitchBg

            Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)

            local function SetToggleState(newState)
                state = newState
                if state then
                    Tween(SwitchBg, 0.2, {BackgroundColor3 = Theme.Accent})
                    Tween(Knob, 0.2, {Position = UDim2.new(1, -20, 0.5, -9)})
                else
                    Tween(SwitchBg, 0.2, {BackgroundColor3 = Color3.fromRGB(50, 55, 65)})
                    Tween(Knob, 0.2, {Position = UDim2.new(0, 2, 0.5, -9)})
                end
                Callback(state)
            end

            local function ToggleState()
                SetToggleState(not state)
            end

            SwitchBg.Activated:Connect(ToggleState)
            
            local ClickArea = Instance.new("TextButton")
            ClickArea.Size = UDim2.new(1, -60, 1, 0)
            ClickArea.BackgroundTransparency = 1
            ClickArea.Text = ""
            ClickArea.Parent = Frame
            ClickArea.Activated:Connect(ToggleState)

            local toggleObj = {
                Name = Name,
                GetState = function() return state end,
                SetState = SetToggleState,
                Toggle = ToggleState,
                UpdateColor = function(col) if state then SwitchBg.BackgroundColor3 = col end end
            }

            table.insert(WindowObj.RegisteredToggles, toggleObj)
            table.insert(WindowObj.RegisteredToggleNames, Name)
            
            if WindowObj.OnToggleAdded then
                WindowObj.OnToggleAdded(Name)
            end
        end

        function TabObj:CreateSlider(options)
            options = options or {}
            local Name = options.Name or "Slider"
            local Min = options.Min or 0
            local Max = options.Max or 100
            local Default = options.Default or Min
            local Callback = options.Callback or function() end
            local value = Default

            local Frame = Instance.new("Frame")
            Frame.Size = UDim2.new(1, 0, 0, 50)
            Frame.BackgroundColor3 = Theme.ElementBackground
            Frame.BackgroundTransparency = Theme.ElementTransparency
            Frame.Parent = TabScroll

            Instance.new("UICorner", Frame).CornerRadius = Theme.CornerRadius
            local Stroke = Instance.new("UIStroke", Frame)
            Stroke.Color = Theme.GlassStroke
            Stroke.Transparency = Theme.GlassStrokeTransparency

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(0.6, 0, 0, 22)
            Label.Position = UDim2.new(0, 12, 0, 4)
            Label.Text = Name
            Label.TextColor3 = Theme.TextWhite
            Label.TextSize = 13
            Label.Font = CurrentFontMedium
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.BackgroundTransparency = 1
            Label.Parent = Frame

            RegisterText(Label, false)

            local ValueText = Instance.new("TextBox")
            ValueText.Size = UDim2.new(0.3, 0, 0, 22)
            ValueText.Position = UDim2.new(0.7, -12, 0, 4)
            ValueText.Text = tostring(value)
            ValueText.TextColor3 = Theme.Accent
            ValueText.TextSize = 13
            ValueText.Font = CurrentFontBold
            ValueText.TextXAlignment = Enum.TextXAlignment.Right
            ValueText.BackgroundTransparency = 1
            ValueText.Parent = Frame

            RegisterText(ValueText, true)

            local SliderTrack = Instance.new("Frame")
            SliderTrack.Size = UDim2.new(1, -24, 0, 8)
            SliderTrack.Position = UDim2.new(0, 12, 1, -16)
            SliderTrack.BackgroundColor3 = Color3.fromRGB(50, 55, 65)
            SliderTrack.Active = true
            SliderTrack.Parent = Frame

            Instance.new("UICorner", SliderTrack).CornerRadius = UDim.new(1, 0)

            local SliderFill = Instance.new("Frame")
            SliderFill.Size = UDim2.new((value - Min) / (Max - Min), 0, 1, 0)
            SliderFill.BackgroundColor3 = Theme.Accent
            SliderFill.Parent = SliderTrack

            Instance.new("UICorner", SliderFill).CornerRadius = UDim.new(1, 0)

            local dragging = false
            local function UpdateSlider(input)
                local pos = math.clamp((input.Position.X - SliderTrack.AbsolutePosition.X) / SliderTrack.AbsoluteSize.X, 0, 1)
                value = math.floor(Min + (Max - Min) * pos)
                ValueText.Text = tostring(value)
                Tween(SliderFill, 0.05, {Size = UDim2.new(pos, 0, 1, 0)})
                Callback(value)
            end

            SliderTrack.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    UpdateSlider(input)
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    UpdateSlider(input)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)

            ValueText.FocusLost:Connect(function()
                local num = tonumber(ValueText.Text)
                if num then
                    value = math.clamp(math.floor(num), Min, Max)
                    ValueText.Text = tostring(value)
                    local pos = (value - Min) / (Max - Min)
                    Tween(SliderFill, 0.2, {Size = UDim2.new(pos, 0, 1, 0)})
                    Callback(value)
                else
                    ValueText.Text = tostring(value)
                end
            end)

            local sliderObj = {
                Name = Name,
                GetValue = function() return value end,
                SetValue = function(newVal)
                    value = math.clamp(newVal, Min, Max)
                    ValueText.Text = tostring(value)
                    Tween(SliderFill, 0.2, {Size = UDim2.new((value - Min) / (Max - Min), 0, 1, 0)})
                    Callback(value)
                end,
                UpdateColor = function(col) SliderFill.BackgroundColor3 = col; ValueText.TextColor3 = col end
            }
            table.insert(WindowObj.RegisteredSliders, sliderObj)
        end

