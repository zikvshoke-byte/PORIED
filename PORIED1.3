            OptionContainer.Parent = Frame

            local OptionLayout = Instance.new("UIListLayout")
            OptionLayout.Padding = UDim.new(0, 4)
            OptionLayout.Parent = OptionContainer

            local function RefreshList(newList)
                List = newList or {}
                for _, child in pairs(OptionContainer:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end

                for _, item in ipairs(List) do
                    local ItemBtn = Instance.new("TextButton")
                    ItemBtn.Size = UDim2.new(1, 0, 0, 26)
                    ItemBtn.BackgroundColor3 = Color3.fromRGB(40, 45, 55)
                    ItemBtn.BackgroundTransparency = 0.3
                    ItemBtn.Text = item
                    ItemBtn.TextColor3 = Theme.TextWhite
                    ItemBtn.TextSize = 11
                    ItemBtn.Font = FontMedium

                    local IBCorner = Instance.new("UICorner")
                    IBCorner.CornerRadius = UDim.new(0, 5)
                    IBCorner.Parent = ItemBtn
                    ItemBtn.Parent = OptionContainer

                    ItemBtn.Activated:Connect(function()
                        SelectedLabel.Text = item
                        expanded = false
                        FastTween(Frame, 0.15, {Size = UDim2.new(1, 0, 0, 38)})
                        Arrow.Rotation = 0
                        Callback({item})
                    end)
                end
            end

            RefreshList(List)

            HeaderBtn.Activated:Connect(function()
                expanded = not expanded
                local targetHeight = expanded and (38 + #OptionContainer:GetChildren() * 30) or 38
                FastTween(Frame, 0.15, {Size = UDim2.new(1, 0, 0, targetHeight)})
                Arrow.Rotation = expanded and 180 or 0
            end)

            return {
                Refresh = function(_, newList)
                    RefreshList(newList)
                end
            }
        end

        -- 6. КНОПКА (BUTTON)
        function TabObj:CreateButton(options)
            options = options or {}
            local Name = options.Name or "Button"
            local Callback = options.Callback or function() end

            local BtnFrame = Instance.new("TextButton")
            BtnFrame.Size = UDim2.new(1, 0, 0, 36)
            BtnFrame.BackgroundColor3 = Theme.ElementBackground
            BtnFrame.BackgroundTransparency = Theme.ElementTransparency
            BtnFrame.Text = Name
            BtnFrame.TextColor3 = Theme.TextWhite
            BtnFrame.TextSize = 12
            BtnFrame.Font = FontMedium
            BtnFrame.AutoButtonColor = false
            BtnFrame.Parent = TabScroll

            local BCorner = Instance.new("UICorner")
            BCorner.CornerRadius = Theme.CornerRadius
            BCorner.Parent = BtnFrame

            BtnFrame.Activated:Connect(function()
                FastTween(BtnFrame, 0.05, {BackgroundColor3 = Theme.Accent, TextColor3 = Color3.fromRGB(0, 0, 0)})
                task.delay(0.08, function()
                    FastTween(BtnFrame, 0.1, {BackgroundColor3 = Theme.ElementBackground, TextColor3 = Theme.TextWhite})
                end)
                Callback()
            end)

            return BtnFrame
        end

        -- 7. НАЗНАЧЕНИЕ КЛАВИШИ (KEYBIND)
        function TabObj:CreateKeybind(options)
            options = options or {}
            local Name = options.Name or "Keybind"
            local Default = options.Default or Enum.KeyCode.E
            local Callback = options.Callback or function() end
            local currentKey = Default
            local listening = false

            local Frame = Instance.new("Frame")
            Frame.Size = UDim2.new(1, 0, 0, 38)
            Frame.BackgroundColor3 = Theme.ElementBackground
            Frame.BackgroundTransparency = Theme.ElementTransparency
            Frame.Parent = TabScroll

            local FCorner = Instance.new("UICorner")
            FCorner.CornerRadius = Theme.CornerRadius
            FCorner.Parent = Frame

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(1, -90, 1, 0)
            Label.Position = UDim2.new(0, 10, 0, 0)
            Label.Text = Name
            Label.TextColor3 = Theme.TextWhite
            Label.TextSize = 12
            Label.Font = FontMedium
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.BackgroundTransparency = 1
            Label.Parent = Frame

            local BindBtn = Instance.new("TextButton")
            BindBtn.Size = UDim2.new(0, 70, 0, 24)
            BindBtn.Position = UDim2.new(1, -80, 0.5, -12)
            BindBtn.BackgroundColor3 = Color3.fromRGB(40, 45, 55)
            BindBtn.Text = currentKey.Name
            BindBtn.TextColor3 = Theme.Accent
            BindBtn.TextSize = 11
            BindBtn.Font = FontBold

            table.insert(WindowObj.RegisteredAccentElements, BindBtn)

            local BCorner = Instance.new("UICorner")
            BCorner.CornerRadius = UDim.new(0, 6)
            BCorner.Parent = BindBtn
            BindBtn.Parent = Frame

            BindBtn.Activated:Connect(function()
                listening = true
                BindBtn.Text = "..."
                BindBtn.TextColor3 = Theme.TextWhite
            end)

            UserInputService.InputBegan:Connect(function(input, gpe)
                if listening and not gpe then
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        currentKey = input.KeyCode
                        BindBtn.Text = currentKey.Name
                        BindBtn.TextColor3 = Theme.Accent
                        listening = false
                        Callback(currentKey)
                    end
                elseif not listening and input.KeyCode == currentKey and not gpe then
                    Callback(currentKey)
                end
            end)
        end

