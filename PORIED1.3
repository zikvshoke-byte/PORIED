    local function RegisterText(inst, isBold, transKey, isUpper)
        if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
            table.insert(WindowObj.AllTextObjects, { Instance = inst, Bold = isBold })
            if transKey then
                table.insert(WindowObj.TranslatableObjects, { Instance = inst, Key = transKey, IsUpper = isUpper })
            end
        end
    end

    RegisterText(Title, true)
    RegisterText(CloseBtn, true)
    RegisterText(PText, true)
    RegisterText(OverlayLabel, true)

    function WindowObj:SetLanguage(langKey)
        CurrentLang = langKey
        for _, objData in ipairs(WindowObj.TranslatableObjects) do
            if objData.Instance and objData.Instance.Parent then
                local txt = Translations[langKey][objData.Key]
                if txt then
                    objData.Instance.Text = objData.IsUpper and txt:upper() or txt
                end
            end
        end
        pcall(function()
            if isfolder and not isfolder("poried_configs") then makefolder("poried_configs") end
            writefile("poried_configs/poried_lang.json", HttpService:JSONEncode({ Lang = langKey }))
        end)
    end

    function WindowObj:SetFont(fontName)
        local medium, bold
        if fontName == "SourceSans" then
            medium, bold = Enum.Font.SourceSans, Enum.Font.SourceSansBold
        elseif fontName == "RobotoMono" then
            medium, bold = Enum.Font.RobotoMono, Enum.Font.RobotoMono
        elseif fontName == "Ubuntu" then
            medium, bold = Enum.Font.Ubuntu, Enum.Font.Ubuntu
        elseif fontName == "FredokaOne" then
            medium, bold = Enum.Font.FredokaOne, Enum.Font.FredokaOne
        else
            medium, bold = Enum.Font.GothamMedium, Enum.Font.GothamBold
        end
        CurrentFontMedium = medium
        CurrentFontBold = bold

        for _, objData in ipairs(WindowObj.AllTextObjects) do
            if objData.Instance and objData.Instance.Parent then
                objData.Instance.Font = objData.Bold and bold or medium
            end
        end

        pcall(function()
            if isfolder and not isfolder("poried_configs") then makefolder("poried_configs") end
            writefile("poried_configs/poried_font.json", HttpService:JSONEncode({ FontName = fontName }))
        end)
    end

    local RainbowConnection = nil
    local function SetThemeColor(color, isRainbow)
        if RainbowConnection then
            RainbowConnection:Disconnect()
            RainbowConnection = nil
        end

        local function ApplyColor(col)
            Theme.Accent = col
            PStroke.Color = col
            PText.TextColor3 = col
            OverlayStroke.Color = col

            for _, t in pairs(WindowObj.Tabs) do
                if t.Scroll.Visible then
                    t.Button.BackgroundColor3 = col
                    t.Stroke.Color = col
                end
            end

            for _, sec in ipairs(WindowObj.RegisteredSections) do
                sec.TextColor3 = col
            end

            for _, toggle in ipairs(WindowObj.RegisteredToggles) do
                if toggle.GetState() then
                    toggle.UpdateColor(col)
                end
            end

            for _, slider in ipairs(WindowObj.RegisteredSliders) do
                slider.UpdateColor(col)
            end

            for _, bindBtn in ipairs(WindowObj.RegisteredBinds) do
                bindBtn.UpdateColor(col)
            end
        end

        if isRainbow then
            RainbowConnection = RunService.RenderStepped:Connect(function()
                local hue = (tick() % 4) / 4
                ApplyColor(Color3.fromHSV(hue, 0.85, 1))
            end)
        else
            ApplyColor(color)
        end

        pcall(function()
            if isfolder and not isfolder("poried_configs") then makefolder("poried_configs") end
            local themeData = { IsRainbow = isRainbow, R = color.R, G = color.G, B = color.B }
            if writefile then
                writefile("poried_configs/poried_theme.json", HttpService:JSONEncode(themeData))
            end
        end)
    end

    pcall(function()
        if readfile and isfile and isfile("poried_configs/poried_theme.json") then
            local data = HttpService:JSONDecode(readfile("poried_configs/poried_theme.json"))
            if data then
                if data.IsRainbow then
                    SetThemeColor(Theme.Accent, true)
                elseif data.R and data.G and data.B then
                    SetThemeColor(Color3.new(data.R, data.G, data.B), false)
                end
            end
        end
    end)

    function WindowObj:CreateTab(tabName, isSpecialOrder)
