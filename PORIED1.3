                elseif elem:IsA("Frame") then
                    elem.BackgroundColor3 = newColor
                end
            end)
        end
        if WindowObj.ActiveTab and WindowObj.ActiveTab.Button then
            WindowObj.ActiveTab.Button.BackgroundColor3 = newColor
        end
    end

