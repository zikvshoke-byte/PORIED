    CloseBtn.Position = UDim2.new(1, -34, 0.5, -13)
    CloseBtn.Text = "X"
    CloseBtn.TextColor3 = Theme.TextWhite
    CloseBtn.TextSize = 12
    RegisterFont(CloseBtn, true)
    CloseBtn.BackgroundColor3 = Theme.ElementBackground
