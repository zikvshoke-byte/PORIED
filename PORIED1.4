local CurrentLang = "EN"
local CurrentFontName = "Gotham"
local CurrentFontMedium = Enum.Font.GothamMedium
local CurrentFontBold = Enum.Font.GothamBold

local function ApplyFontByName(fontName)
    CurrentFontName = fontName or "Gotham"
    if CurrentFontName == "SourceSans" then
        CurrentFontMedium = Enum.Font.SourceSans
        CurrentFontBold = Enum.Font.SourceSansBold
    elseif CurrentFontName == "RobotoMono" then
        CurrentFontMedium = Enum.Font.RobotoMono
        CurrentFontBold = Enum.Font.RobotoMono
    elseif CurrentFontName == "Ubuntu" then
        CurrentFontMedium = Enum.Font.Ubuntu
        CurrentFontBold = Enum.Font.Ubuntu
    elseif CurrentFontName == "FredokaOne" then
        CurrentFontMedium = Enum.Font.FredokaOne
        CurrentFontBold = Enum.Font.FredokaOne
    else
        CurrentFontName = "Gotham"
        CurrentFontMedium = Enum.Font.GothamMedium
        CurrentFontBold = Enum.Font.GothamBold
    end
end

