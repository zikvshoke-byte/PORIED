    CloseBtn.Parent = TopBar

    Instance.new("UICorner", CloseBtn).CornerRadius = UDim.new(1, 0)
    CloseBtn.Activated:Connect(ToggleWindowVisibility)

    local ContentContainer = Instance.new("Frame")
    ContentContainer.Name = "ContentContainer"
    ContentContainer.Size = UDim2.new(1, -20, 1, -55)
    ContentContainer.Position = UDim2.new(0, 10, 0, 50)
    ContentContainer.BackgroundTransparency = 1
    ContentContainer.ClipsDescendants = true
    ContentContainer.Parent = MainFrame

    -- Плавающая кнопка PORIED
    local PoriedButton = Instance.new("Frame")
    PoriedButton.Name = "PoriedFloatButton"
    PoriedButton.Size = UDim2.new(0, 85, 0, 34)
    PoriedButton.Position = UDim2.new(UIState.FloatBtn.ScaleX, UIState.FloatBtn.OffsetX, UIState.FloatBtn.ScaleY, UIState.FloatBtn.OffsetY)
    PoriedButton.BackgroundColor3 = Theme.MainBackground
    PoriedButton.BackgroundTransparency = 0.2
    PoriedButton.Parent = ScreenGui

    Instance.new("UICorner", PoriedButton).CornerRadius = UDim.new(1, 0)

    local PStroke = Instance.new("UIStroke", PoriedButton)
    PStroke.Color = Theme.Accent
    PStroke.Thickness = 1.5

    local PText = Instance.new("TextLabel")
    PText.Size = UDim2.new(1, 0, 1, 0)
    PText.BackgroundTransparency = 1
    PText.Text = "PORIED"
    RegisterAccentText(PText)
    PText.TextSize = 12
    RegisterFont(PText, true)
    PText.Parent = PoriedButton

    MakeDraggableAndClickable(PoriedButton, PText, ToggleWindowVisibility, function()
        UIState.FloatBtn.ScaleX = PoriedButton.Position.X.Scale
        UIState.FloatBtn.OffsetX = PoriedButton.Position.X.Offset
        UIState.FloatBtn.ScaleY = PoriedButton.Position.Y.Scale
        UIState.FloatBtn.OffsetY = PoriedButton.Position.Y.Offset
        SaveUIState()
    end)

    -- // КАПСУЛЬНЫЙ ОВЕРЛЕЙ // --
    local OverlaySettings = UIState.Overlay

    local OverlayFrame = Instance.new("Frame")
    OverlayFrame.Name = "PoriedOverlay"
    OverlayFrame.Size = UDim2.new(0, 200, 0, 30)
    OverlayFrame.Position = UDim2.new(OverlaySettings.ScaleX or 0, OverlaySettings.OffsetX or 15, OverlaySettings.ScaleY or 0, OverlaySettings.OffsetY or 15)
    OverlayFrame.BackgroundColor3 = Theme.MainBackground
    OverlayFrame.BackgroundTransparency = 0.2
    OverlayFrame.Parent = ScreenGui

    Instance.new("UICorner", OverlayFrame).CornerRadius = UDim.new(1, 0)

    local OverlayStroke = Instance.new("UIStroke", OverlayFrame)
    OverlayStroke.Color = Theme.Accent
    OverlayStroke.Thickness = 1.5

    local OverlayLabel = Instance.new("TextLabel")
    OverlayLabel.Size = UDim2.new(1, 0, 1, 0)
    OverlayLabel.BackgroundTransparency = 1
    OverlayLabel.TextColor3 = Theme.TextWhite
    OverlayLabel.TextSize = 11
    RegisterFont(OverlayLabel, true)
    OverlayLabel.TextXAlignment = Enum.TextXAlignment.Center
    OverlayLabel.Parent = OverlayFrame

    MakeDraggable(OverlayFrame, OverlayFrame, function()
        OverlaySettings.ScaleX = OverlayFrame.Position.X.Scale
        OverlaySettings.OffsetX = OverlayFrame.Position.X.Offset
        OverlaySettings.ScaleY = OverlayFrame.Position.Y.Scale
        OverlaySettings.OffsetY = OverlayFrame.Position.Y.Offset
        SaveUIState()
    end)

    local fps = 60
    local frameCount = 0
    local lastFpsUpdate = tick()

    RunService.RenderStepped:Connect(function()
        frameCount = frameCount + 1
        local now = tick()
        if now - lastFpsUpdate >= 0.5 then
            fps = math.floor(frameCount / (now - lastFpsUpdate))
            frameCount = 0
            lastFpsUpdate = now

            if not OverlaySettings.Enabled then
                OverlayFrame.Visible = false
                return
            end

            local parts = {}
            if OverlaySettings.ShowFPS then
                table.insert(parts, fps .. " FPS")
            end
            if OverlaySettings.ShowPing then
                local ping = 0
                pcall(function()
                    ping = math.floor(StatsService.Network.ServerStatsItem["Data Ping"]:GetValue())
                end)
                table.insert(parts, ping .. "ms")
            end
            if OverlaySettings.ShowName then
                table.insert(parts, LocalPlayer.DisplayName or LocalPlayer.Name)
            end

            if #parts > 0 then
                OverlayFrame.Visible = true
                OverlayLabel.Text = table.concat(parts, "  |  ")
                local textWidth = OverlayLabel.TextBounds.X + 26
                OverlayFrame.Size = UDim2.new(0, math.max(100, textWidth), 0, 30)
            else
                OverlayFrame.Visible = false
            end
        end
    end)

    local WindowObj = {
        ScreenGui = ScreenGui,
        MainFrame = MainFrame,
        Tabs = {},
        ActiveTab = nil,
        RegisteredToggles = {},
        RegisteredToggleNames = {},
        RegisteredSliders = {},
        RegisteredDropdowns = {},
        RegisteredSections = {},
        RegisteredBinds = {},
        ContentContainer = ContentContainer,
        TabBarScroller = TabBarScroller,
        TabListLayout = TabListLayout,
        OverlaySettings = OverlaySettings,
        CustomTabCreated = false,
        ConfigTabCreated = false,
        BindsTabCreated = false,
        Notify = ShowToast
    }

    -- Динамическое обновление темы (с оптимизированной радугой)
    local RainbowConnection = nil
    local function SetThemeColor(color, isRainbow, themeName)
        if RainbowConnection then
            RainbowConnection:Disconnect()
            RainbowConnection = nil
        end

        local function ApplyColor(col)
            Theme.Accent = col
            PStroke.Color = col
            OverlayStroke.Color = col
            ToastStroke.Color = col
            TabBarScroller.ScrollBarImageColor3 = col

            for _, txt in ipairs(AccentTextRegistry) do
                if txt and txt.Parent then txt.TextColor3 = col end
            end

            for _, t in pairs(WindowObj.Tabs) do
                t.Scroll.ScrollBarImageColor3 = col
                if t.Scroll.Visible then
                    t.Button.BackgroundColor3 = col
                    t.Stroke.Color = col
                end
            end

            for _, sec in ipairs(WindowObj.RegisteredSections) do
                sec.TextColor3 = col
            end

            for _, toggle in ipairs(WindowObj.RegisteredToggles) do
                toggle.UpdateColor(col)
            end

            for _, slider in ipairs(WindowObj.RegisteredSliders) do
                slider.UpdateColor(col)
            end

            for _, bindBtn in ipairs(WindowObj.RegisteredBinds) do
                bindBtn.UpdateColor(col)
            end

            if WindowObj.RefreshThemeButtons then
                WindowObj.RefreshThemeButtons()
            end
        end

        if isRainbow then
            local lastRainbowTick = 0
            RainbowConnection = RunService.RenderStepped:Connect(function()
                local now = tick()
                if now - lastRainbowTick >= 0.04 then
                    lastRainbowTick = now
                    local hue = (now % 5) / 5
                    ApplyColor(Color3.fromHSV(hue, 0.85, 1))
                end
            end)
        else
            ApplyColor(color)
        end

        SaveJSON("poried_theme.json", {
            ThemeName = themeName or "Custom",
            IsRainbow = isRainbow or false,
            R = color.R,
            G = color.G,
            B = color.B
        })
    end

    -- Загрузка сохранённой темы при старте
    do
        local themeData = LoadJSON("poried_theme.json")
        if themeData then
            if themeData.IsRainbow then
                SetThemeColor(Theme.Accent, true, "RGB Rainbow")
            elseif themeData.R and themeData.G and themeData.B then
                SetThemeColor(Color3.new(themeData.R, themeData.G, themeData.B), false, themeData.ThemeName)
            end
        end
    end

    function WindowObj:CreateTab(tabName, isSpecialOrder)
        local TabButton = Instance.new("TextButton")
        TabButton.Size = UDim2.new(0, 75, 0, 28)
        TabButton.AutomaticSize = Enum.AutomaticSize.X
        TabButton.Text = tabName
        TabButton.TextColor3 = Theme.TextDark
        TabButton.TextSize = 12
        RegisterFont(TabButton, false)
        TabButton.TextStrokeTransparency = 0.4
        TabButton.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        TabButton.BackgroundColor3 = Theme.ElementBackground
        TabButton.BackgroundTransparency = 0.5
        TabButton.LayoutOrder = isSpecialOrder or #WindowObj.Tabs + 1
        TabButton.Parent = TabBarScroller

        local BtnPad = Instance.new("UIPadding", TabButton)
        BtnPad.PaddingLeft = UDim.new(0, 10)
        BtnPad.PaddingRight = UDim.new(0, 10)

        Instance.new("UICorner", TabButton).CornerRadius = UDim.new(0, 8)

        local TabStroke = Instance.new("UIStroke", TabButton)
        TabStroke.Color = Theme.GlassStroke
        TabStroke.Transparency = 1

        local TabScroll = Instance.new("ScrollingFrame")
        TabScroll.Name = "TabScroll_" .. tabName
        TabScroll.Size = UDim2.new(1, 0, 1, 0)
        TabScroll.BackgroundTransparency = 1
        TabScroll.ScrollBarThickness = 3
        TabScroll.ScrollBarImageColor3 = Theme.Accent
        TabScroll.Visible = false
        TabScroll.Parent = ContentContainer

        local ScrollLayout = Instance.new("UIListLayout")
        ScrollLayout.SortOrder = Enum.SortOrder.LayoutOrder
        ScrollLayout.Padding = UDim.new(0, 8)
        ScrollLayout.Parent = TabScroll

        local ScrollPadding = Instance.new("UIPadding")
        ScrollPadding.PaddingTop = UDim.new(0, 4)
        ScrollPadding.PaddingBottom = UDim.new(0, 10)
        ScrollPadding.PaddingLeft = UDim.new(0, 4)
        ScrollPadding.PaddingRight = UDim.new(0, 8)
        ScrollPadding.Parent = TabScroll

        ScrollLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            TabScroll.CanvasSize = UDim2.new(0, 0, 0, ScrollLayout.AbsoluteContentSize.Y + 15)
        end)

        local function ActivateTab()
            for _, t in pairs(WindowObj.Tabs) do
                t.Scroll.Visible = false
                Tween(t.Button, 0.2, {BackgroundColor3 = Theme.ElementBackground, TextColor3 = Theme.TextDark})
                t.Stroke.Transparency = 1
            end
            TabScroll.Visible = true
            Tween(TabButton, 0.2, {BackgroundColor3 = Theme.Accent, TextColor3 = Color3.fromRGB(0, 0, 0)})
            TabStroke.Color = Theme.Accent
            TabStroke.Transparency = 0.5
            WindowObj.ActiveTab = TabScroll
        end

        TabButton.Activated:Connect(ActivateTab)

        if #WindowObj.Tabs == 0 then
            ActivateTab()
        end

        local TabObj = {Scroll = TabScroll, Button = TabButton, Stroke = TabStroke}
        table.insert(WindowObj.Tabs, TabObj)

        function TabObj:CreateSection(text)
            local SecFrame = Instance.new("Frame")
            SecFrame.Size = UDim2.new(1, 0, 0, 22)
