            MainFrame.Visible = true
            Tween(MainFrame, 0.25, {Size = UDim2.new(0, 520, 0, 340)})
        else
            Tween(MainFrame, 0.2, {Size = UDim2.new(0, 0, 0, 0)})
            task.delay(0.2, function()
                if not windowVisible then MainFrame.Visible = false end
            end)
        end
    end

    -- Кнопка "X" теперь аккуратно сворачивает окно вместо удаления GUI
    local CloseBtn = Instance.new("TextButton")
