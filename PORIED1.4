            local OptionContainer = Instance.new("ScrollingFrame")
            OptionContainer.Size = UDim2.new(1, -20, 0, 150)
            OptionContainer.Position = UDim2.new(0, 10, 0, 42)
            OptionContainer.BackgroundTransparency = 1
            OptionContainer.ScrollBarThickness = 2
            OptionContainer.ScrollBarImageColor3 = Theme.Accent
            OptionContainer.CanvasSize = UDim2.new(0, 0, 0, 0)
            OptionContainer.Parent = Frame

            local OptionLayout = Instance.new("UIListLayout")
            OptionLayout.Padding = UDim.new(0, 4)
            OptionLayout.Parent = OptionContainer

            OptionLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                OptionContainer.CanvasSize = UDim2.new(0, 0, 0, OptionLayout.AbsoluteContentSize.Y + 6)
            end)

            local itemCount = 0
            local function GetExpandedHeight()
                local listH = math.min(itemCount * 32, 160)
                return 46 + listH
            end

            local function RefreshList(newList)
                List = newList or {}
                for _, child in pairs(OptionContainer:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end

                itemCount = #List
                if itemCount > 0 and (SelectedLabel.Text == "None" or SelectedLabel.Text == "") then
                    SelectedLabel.Text = List[1]
                elseif itemCount == 0 then
                    SelectedLabel.Text = "None"
                end

                for _, item in ipairs(List) do
                    local ItemBtn = Instance.new("TextButton")
                    ItemBtn.Size = UDim2.new(1, -4, 0, 28)
                    ItemBtn.BackgroundColor3 = Color3.fromRGB(40, 45, 55)
                    ItemBtn.BackgroundTransparency = 0.3
                    ItemBtn.Text = item
                    ItemBtn.TextColor3 = Theme.TextWhite
                    ItemBtn.TextSize = 12
                    RegisterFont(ItemBtn, false)
                    ItemBtn.Parent = OptionContainer

                    Instance.new("UICorner", ItemBtn).CornerRadius = UDim.new(0, 6)

                    ItemBtn.Activated:Connect(function()
                        SelectedLabel.Text = item
                        expanded = false
                        Tween(Frame, 0.2, {Size = UDim2.new(1, 0, 0, 42)})
                        Tween(Arrow, 0.2, {Rotation = 0})
                        Callback({item})
                    end)
                end

                OptionContainer.Size = UDim2.new(1, -20, 0, math.min(itemCount * 32, 160))
                if expanded then
                    Tween(Frame, 0.2, {Size = UDim2.new(1, 0, 0, GetExpandedHeight())})
                end
            end

            RefreshList(List)

            HeaderBtn.Activated:Connect(function()
                if itemCount == 0 then return end
                expanded = not expanded
                local targetHeight = expanded and GetExpandedHeight() or 42
                Tween(Frame, 0.2, {Size = UDim2.new(1, 0, 0, targetHeight)})
                Tween(Arrow, 0.2, {Rotation = expanded and 180 or 0})
            end)

            local dropdownObj = {
                Name = Name,
                LabelInstance = Label,
                GetValue = function() return SelectedLabel.Text end,
                SetValue = function(val, silent)
                    SelectedLabel.Text = val
                    if not silent then
                        Callback({val})
                    end
                end,
                Refresh = function(_, newList)
                    RefreshList(newList)
                end
            }
            table.insert(WindowObj.RegisteredDropdowns, dropdownObj)

            return dropdownObj
        end

