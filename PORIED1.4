            TBtn.BackgroundColor3 = (th.Name == activeThemeName) and Theme.Accent or Color3.fromRGB(40, 45, 55)
            TBtn.BackgroundTransparency = (th.Name == activeThemeName) and 0 or 0.3
            TBtn.Text = "  " .. th.Name
            TBtn.TextColor3 = (th.Name == activeThemeName) and Color3.fromRGB(0, 0, 0) or Theme.TextWhite
            TBtn.TextSize = 12
            RegisterFont(TBtn, true)
            TBtn.TextXAlignment = Enum.TextXAlignment.Left
            TBtn.Parent = ThemeButtonsContainer

            Instance.new("UICorner", TBtn).CornerRadius = UDim.new(0, 6)
            ThemeBtns[th.Name] = TBtn

            TBtn.Activated:Connect(function()
                activeThemeName = th.Name
                SetThemeColor(th.Color or Theme.Accent, th.IsRainbow or false, th.Name)
                RefreshThemeUI()
                ShowToast("Theme: " .. th.Name)
            end)
        end

        -- ВЫБОР ЯЗЫКА (LANGUAGE SELECTOR С МГНОВЕННЫМ ОБНОВЛЕНИЕМ)
        local SecLang = CustomTab:CreateSection(Translations[CurrentLang].LanguageSelector)
        RegisterTranslatable(SecLang, "LanguageSelector", "", true)

        local langDropdown = CustomTab:CreateDropdown({
            Name = "Language",
            Options = {"English", "Русский"},
            Callback = function(sel)
                local langKey = sel[1] == "Русский" and "RU" or "EN"
                CurrentLang = langKey
                SaveJSON("poried_lang.json", { Lang = langKey })
                for _, updateFn in ipairs(TranslatableRegistry) do
                    pcall(updateFn)
                end
                ShowToast(langKey == "RU" and "Язык: Русский" or "Language: English")
            end
        })
        langDropdown.SetValue(CurrentLang == "RU" and "Русский" or "English", true)

        -- ВЫБОР ШРИФТА (FONT SELECTOR С МГНОВЕННЫМ ОБНОВЛЕНИЕМ)
        local SecFont = CustomTab:CreateSection(Translations[CurrentLang].FontSelector)
        RegisterTranslatable(SecFont, "FontSelector", "", true)

        local fontDropdown = CustomTab:CreateDropdown({
            Name = "Font Style",
            Options = {"Gotham", "SourceSans", "RobotoMono", "Ubuntu", "FredokaOne"},
            Callback = function(sel)
                local fontName = sel[1]
                ApplyFontByName(fontName)
                for _, item in ipairs(FontRegistry) do
                    if item.Instance and item.Instance.Parent then
                        item.Instance.Font = item.IsBold and CurrentFontBold or CurrentFontMedium
                    end
                end
                SaveJSON("poried_font.json", { FontName = CurrentFontName })
                ShowToast("Font: " .. CurrentFontName)
            end
        })
        fontDropdown.SetValue(CurrentFontName, true)
    end

    -- // ВСТРОЕННАЯ ВКЛАДКА "CONFIG" // --
    function WindowObj:CreateConfigTab()
        if WindowObj.ConfigTabCreated then return end
        WindowObj.ConfigTabCreated = true

        local ConfigTab = WindowObj:CreateTab("Config", 998)
        local SecSave = ConfigTab:CreateSection(Translations[CurrentLang].SaveCurrentConfig)
        RegisterTranslatable(SecSave, "SaveCurrentConfig", "", true)

        local newConfigName = ""
        local selectedConfigName = ""

        local cfgInput, cfgInputLabel = ConfigTab:CreateInput({
            Name = Translations[CurrentLang].ConfigName,
            PlaceholderText = "e.g. Legit, Rage",
            Callback = function(txt)
                newConfigName = txt
            end
        })
        RegisterTranslatable(cfgInputLabel, "ConfigName", "", false)

        local function GetSavedConfigNames()
            local list = {}
            pcall(function()
                EnsureConfigFolder()
                if listfiles then
                    for _, file in ipairs(listfiles("poried_configs")) do
                        if file:sub(-5) == ".json"
                            and not file:find("poried_theme")
                            and not file:find("poried_binds")
                            and not file:find("poried_lang")
                            and not file:find("poried_font")
                            and not file:find("poried_ui_state")
                        then
                            local name = file:match("([^/^\\]+)%.json$")
                            if name then table.insert(list, name) end
                        end
                    end
                end
            end)
            return list
        end

        local function LoadConfigByName(cfgName)
            if not cfgName or cfgName == "" or cfgName == "None" then return false end
            local data = LoadJSON(cfgName .. ".json")
            if data then
                if data.Toggles then
                    for name, state in pairs(data.Toggles) do
                        for _, t in ipairs(WindowObj.RegisteredToggles) do
                            if t.Name == name then t.SetState(state) end
                        end
                    end
                end
                if data.Sliders then
                    for name, val in pairs(data.Sliders) do
                        for _, s in ipairs(WindowObj.RegisteredSliders) do
                            if s.Name == name then s.SetValue(val) end
                        end
                    end
                end
                if data.Dropdowns then
                    for name, val in pairs(data.Dropdowns) do
                        for _, d in ipairs(WindowObj.RegisteredDropdowns) do
                            if d.Name == name and d.Name ~= Translations.EN.SelectConfig and d.Name ~= Translations.RU.SelectConfig then
                                d.SetValue(val)
                            end
                        end
                    end
                end
                if data.Overlay then
                    for k, v in pairs(data.Overlay) do
                        WindowObj.OverlaySettings[k] = v
                    end
                    SaveUIState()
                end
                return true
            end
            return false
        end

        local saveBtn = ConfigTab:CreateButton({
            Name = Translations[CurrentLang].SaveConfigBtn,
            Callback = function()
                local targetName = (newConfigName ~= "" and newConfigName) or selectedConfigName
                if targetName == "" or targetName == "None" then
                    ShowToast("Enter Config Name!")
                    return
                end

                local data = {
                    Toggles = {},
                    Sliders = {},
                    Dropdowns = {},
                    Overlay = WindowObj.OverlaySettings
                }

                for _, t in ipairs(WindowObj.RegisteredToggles) do
                    data.Toggles[t.Name] = t.GetState()
                end
                for _, s in ipairs(WindowObj.RegisteredSliders) do
                    data.Sliders[s.Name] = s.GetValue()
                end
                for _, d in ipairs(WindowObj.RegisteredDropdowns) do
                    data.Dropdowns[d.Name] = d.GetValue()
                end

                SaveJSON(targetName .. ".json", data)
                local names = GetSavedConfigNames()
                if WindowObj.ConfigDropdownObj then
                    WindowObj.ConfigDropdownObj:Refresh(names)
                    WindowObj.ConfigDropdownObj.SetValue(targetName, true)
                end
                selectedConfigName = targetName
                ShowToast("Saved: " .. targetName)
            end
        })
        RegisterTranslatable(saveBtn, "SaveConfigBtn", "", false)

        local SecManage = ConfigTab:CreateSection(Translations[CurrentLang].ManageConfigs)
        RegisterTranslatable(SecManage, "ManageConfigs", "", true)

        local initialConfigs = GetSavedConfigNames()
        selectedConfigName = initialConfigs[1] or ""

        WindowObj.ConfigDropdownObj = ConfigTab:CreateDropdown({
            Name = Translations[CurrentLang].SelectConfig,
            Options = initialConfigs,
            Callback = function(selected)
                selectedConfigName = selected[1]
            end
        })
        RegisterTranslatable(WindowObj.ConfigDropdownObj.LabelInstance, "SelectConfig", "", false)

        local loadBtn = ConfigTab:CreateButton({
            Name = Translations[CurrentLang].LoadConfigBtn,
            Callback = function()
                if LoadConfigByName(selectedConfigName) then
                    ShowToast("Loaded: " .. selectedConfigName)
                else
                    ShowToast("Select a Config first!")
                end
            end
        })
        RegisterTranslatable(loadBtn, "LoadConfigBtn", "", false)

        local delBtn = ConfigTab:CreateButton({
            Name = Translations[CurrentLang].DeleteConfigBtn,
            Callback = function()
                if selectedConfigName == "" or selectedConfigName == "None" then return end
                local deleted = selectedConfigName
                pcall(function()
                    if isfile and isfile("poried_configs/" .. deleted .. ".json") then
                        delfile("poried_configs/" .. deleted .. ".json")
                    end
                end)
                if UIState.AutoLoadConfig == deleted then
                    UIState.AutoLoadConfig = ""
                    SaveUIState()
                end
                local names = GetSavedConfigNames()
                selectedConfigName = names[1] or ""
                if WindowObj.ConfigDropdownObj then
                    WindowObj.ConfigDropdownObj:Refresh(names)
                end
                ShowToast("Deleted: " .. deleted)
            end
        })
        RegisterTranslatable(delBtn, "DeleteConfigBtn", "", false)

        local autoLoadToggle = ConfigTab:CreateToggle({
            Name = Translations[CurrentLang].AutoLoadToggle,
            Default = (UIState.AutoLoadConfig ~= "" and UIState.AutoLoadConfig ~= nil),
            Callback = function(v)
                if v and selectedConfigName ~= "" and selectedConfigName ~= "None" then
                    UIState.AutoLoadConfig = selectedConfigName
                    SaveUIState()
                    ShowToast("Auto-Load: " .. selectedConfigName)
                else
                    UIState.AutoLoadConfig = ""
                    SaveUIState()
                end
            end
        })
        RegisterTranslatable(autoLoadToggle.LabelInstance, "AutoLoadToggle", "", false)

        -- Авто-загрузка выбранного конфига после инициализации всех вкладок чита
        if UIState.AutoLoadConfig and UIState.AutoLoadConfig ~= "" then
            task.delay(0.6, function()
                if LoadConfigByName(UIState.AutoLoadConfig) then
                    ShowToast("Auto-Loaded: " .. UIState.AutoLoadConfig)
                end
            end)
        end
    end

    -- // ВСТРОЕННАЯ ВКЛАДКА "BINDS" С ДВУСТОРОННЕЙ СИНХРОНИЗАЦИЕЙ И УДАЛЕНИЕМ // --
    function WindowObj:CreateBindsTab()
        if WindowObj.BindsTabCreated then return end
        WindowObj.BindsTabCreated = true

        local BindTab = WindowObj:CreateTab("Binds", 999)
        local SecBinds = BindTab:CreateSection(Translations[CurrentLang].QuickActionBinds)
        RegisterTranslatable(SecBinds, "QuickActionBinds", "", true)

        local selectedToggleName = WindowObj.RegisteredToggleNames[1] or ""
        local bindLabelText = "AIM"

        local DropdownObj = BindTab:CreateDropdown({
            Name = Translations[CurrentLang].SelectFeature,
            Options = WindowObj.RegisteredToggleNames,
            Callback = function(selected)
                selectedToggleName = selected[1]
            end
        })
        RegisterTranslatable(DropdownObj.LabelInstance, "SelectFeature", "", false)

        WindowObj.OnToggleAdded = function(newName)
            if selectedToggleName == "" or selectedToggleName == "None" then
                selectedToggleName = newName
            end
            DropdownObj:Refresh(WindowObj.RegisteredToggleNames)
        end

        local bindInput, bindInputLabel = BindTab:CreateInput({
            Name = Translations[CurrentLang].ButtonLabel,
            PlaceholderText = "e.g. AIM, WC, ESP",
            Callback = function(txt)
                if txt and #txt > 0 then
                    bindLabelText = txt:sub(1, 3):upper()
                end
            end
        })
        RegisterTranslatable(bindInputLabel, "ButtonLabel", "", false)

        local SavedBindsData = {}

        local function SaveBindsToFile()
            SaveJSON("poried_binds.json", SavedBindsData)
        end

        local function SpawnBindButton(toggleName, labelText, posScaleX, posOffsetX, posScaleY, posOffsetY)
            local targetToggle = nil
            for _, t in ipairs(WindowObj.RegisteredToggles) do
                if t.Name == toggleName then
                    targetToggle = t
                    break
                end
            end

            if not targetToggle then return end

            local BindBtnFrame = Instance.new("Frame")
            BindBtnFrame.Name = "BindBtn_" .. labelText
            BindBtnFrame.Size = UDim2.new(0, 44, 0, 44)
            BindBtnFrame.Position = UDim2.new(posScaleX or 0.1, posOffsetX or math.random(10, 80), posScaleY or 0.3, posOffsetY or math.random(10, 80))
            BindBtnFrame.BackgroundColor3 = targetToggle.GetState() and Theme.Accent or Theme.MainBackground
            BindBtnFrame.BackgroundTransparency = 0.2
            BindBtnFrame.Parent = ScreenGui

            Instance.new("UICorner", BindBtnFrame).CornerRadius = UDim.new(1, 0)

            local BindStroke = Instance.new("UIStroke", BindBtnFrame)
            BindStroke.Color = Theme.Accent
            BindStroke.Thickness = 1.5

            local BindTextLabel = Instance.new("TextLabel")
            BindTextLabel.Size = UDim2.new(1, 0, 1, 0)
            BindTextLabel.BackgroundTransparency = 1
            BindTextLabel.Text = labelText:sub(1, 3)
            BindTextLabel.TextColor3 = targetToggle.GetState() and Color3.fromRGB(0, 0, 0) or Theme.Accent
            BindTextLabel.TextSize = 12
            RegisterFont(BindTextLabel, true)
            BindTextLabel.Parent = BindBtnFrame

            local function SyncVisual(state)
                if state then
                    Tween(BindBtnFrame, 0.2, {BackgroundColor3 = Theme.Accent})
                    Tween(BindTextLabel, 0.2, {TextColor3 = Color3.fromRGB(0, 0, 0)})
                else
                    Tween(BindBtnFrame, 0.2, {BackgroundColor3 = Theme.MainBackground})
                    Tween(BindTextLabel, 0.2, {TextColor3 = Theme.Accent})
                end
            end

            local bindObj = {
                ToggleName = toggleName,
                Label = labelText,
                Frame = BindBtnFrame,
                SyncState = SyncVisual,
                UpdateColor = function(col)
                    BindStroke.Color = col
                    if targetToggle.GetState() then
                        BindBtnFrame.BackgroundColor3 = col
                        BindTextLabel.TextColor3 = Color3.fromRGB(0, 0, 0)
                    else
                        BindTextLabel.TextColor3 = col
                    end
                end
            }
            table.insert(WindowObj.RegisteredBinds, bindObj)

            MakeDraggableAndClickable(BindBtnFrame, BindTextLabel, function()
                targetToggle.Toggle()
                SyncVisual(targetToggle.GetState())
            end, function()
                for _, b in ipairs(SavedBindsData) do
                    if b.ToggleName == toggleName and b.Label == labelText then
                        b.ScaleX = BindBtnFrame.Position.X.Scale
                        b.OffsetX = BindBtnFrame.Position.X.Offset
                        b.ScaleY = BindBtnFrame.Position.Y.Scale
                        b.OffsetY = BindBtnFrame.Position.Y.Offset
                        break
                    end
                end
                SaveBindsToFile()
            end)
        end

        -- Восстановление сохраненных биндов из файла (AIM, WC и др.)
        local loadedBinds = LoadJSON("poried_binds.json")
        if loadedBinds and type(loadedBinds) == "table" then
            SavedBindsData = loadedBinds
            task.delay(0.5, function()
                for _, b in ipairs(SavedBindsData) do
                    SpawnBindButton(b.ToggleName, b.Label, b.ScaleX, b.OffsetX, b.ScaleY, b.OffsetY)
                end
            end)
        end

        local createBindBtn = BindTab:CreateButton({
            Name = Translations[CurrentLang].CreateBindBtn,
            Callback = function()
                if selectedToggleName == "" or selectedToggleName == "None" then
                    selectedToggleName = WindowObj.RegisteredToggleNames[1] or ""
                end
                if selectedToggleName == "" then return end

                local bindItem = {
                    ToggleName = selectedToggleName,
                    Label = bindLabelText,
                    ScaleX = 0.1,
                    OffsetX = math.random(10, 80),
                    ScaleY = 0.3,
                    OffsetY = math.random(10, 80)
                }

                table.insert(SavedBindsData, bindItem)
                SaveBindsToFile()

                SpawnBindButton(bindItem.ToggleName, bindItem.Label, bindItem.ScaleX, bindItem.OffsetX, bindItem.ScaleY, bindItem.OffsetY)
                ShowToast("Bind Created: " .. bindLabelText)
            end
        })
        RegisterTranslatable(createBindBtn, "CreateBindBtn", "", false)

        local removeLastBtn = BindTab:CreateButton({
            Name = Translations[CurrentLang].RemoveLastBindBtn,
            Callback = function()
                if #WindowObj.RegisteredBinds > 0 then
                    local lastBind = table.remove(WindowObj.RegisteredBinds)
                    if lastBind and lastBind.Frame then
                        lastBind.Frame:Destroy()
                    end
                    table.remove(SavedBindsData)
                    SaveBindsToFile()
                    ShowToast("Removed Last Bind")
                end
            end
        })
        RegisterTranslatable(removeLastBtn, "RemoveLastBindBtn", "", false)

        local clearBindsBtn = BindTab:CreateButton({
            Name = Translations[CurrentLang].ClearBindsBtn,
            Callback = function()
                for _, b in ipairs(WindowObj.RegisteredBinds) do
                    if b.Frame then b.Frame:Destroy() end
                end
                table.clear(WindowObj.RegisteredBinds)
                table.clear(SavedBindsData)
                SaveBindsToFile()
                ShowToast("All Binds Cleared")
            end
        })
        RegisterTranslatable(clearBindsBtn, "ClearBindsBtn", "", false)
    end

    -- Автоматические вызовы встроенных системных вкладок
    WindowObj:CreateCustomTab()
    WindowObj:CreateConfigTab()
    WindowObj:CreateBindsTab()

    return WindowObj
end

return PoriedUI
