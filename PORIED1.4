    MakeDraggable(MainFrame, TopBar, function()
        UIState.MainWin.ScaleX = MainFrame.Position.X.Scale
        UIState.MainWin.OffsetX = MainFrame.Position.X.Offset
        UIState.MainWin.ScaleY = MainFrame.Position.Y.Scale
