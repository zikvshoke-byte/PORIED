    local UIState = LoadJSON("poried_ui_state.json") or {
        Overlay = { Enabled = true, ShowFPS = true, ShowPing = true, ShowName = true, ScaleX = 0, OffsetX = 15, ScaleY = 0, OffsetY = 15 },
        FloatBtn = { ScaleX = 0.05, OffsetX = 0, ScaleY = 0.15, OffsetY = 0 },
        MainWin = { ScaleX = 0.5, OffsetX = -260, ScaleY = 0.5, OffsetY = -170 },
        AutoLoadConfig = ""
    }

    local function SaveUIState()
        SaveJSON("poried_ui_state.json", UIState)
    end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "PoriedUI_" .. math.random(1000, 9999)
    ScreenGui.ResetOnSpawn = false
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

    pcall(function() ScreenGui.Parent = (gethui and gethui()) or CoreGui end)
    if not ScreenGui.Parent then ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end

    -- Реестры для живого обновления шрифтов, цветов и локализации
    local FontRegistry = {}
    local function RegisterFont(inst, isBold)
        inst.Font = isBold and CurrentFontBold or CurrentFontMedium
        table.insert(FontRegistry, { Instance = inst, IsBold = isBold })
    end

    local AccentTextRegistry = {}
    local function RegisterAccentText(inst)
        inst.TextColor3 = Theme.Accent
        table.insert(AccentTextRegistry, inst)
    end

    local TranslatableRegistry = {}
    local function RegisterTranslatable(inst, key, prefix, isUpper)
        local function UpdateText()
            local t = Translations[CurrentLang][key] or key
            if isUpper then t = t:upper() end
            inst.Text = (prefix or "") .. t
        end
        UpdateText()
        table.insert(TranslatableRegistry, UpdateText)
    end

    -- Всплывающие уведомления (Toast) внутри меню
    local ToastFrame = Instance.new("Frame")
    ToastFrame.Size = UDim2.new(0, 220, 0, 34)
    ToastFrame.Position = UDim2.new(0.5, -110, 1, 50)
    ToastFrame.BackgroundColor3 = Theme.MainBackground
    ToastFrame.BackgroundTransparency = 0.15
    ToastFrame.ZIndex = 100
    ToastFrame.Parent = ScreenGui
    Instance.new("UICorner", ToastFrame).CornerRadius = UDim.new(1, 0)

    local ToastStroke = Instance.new("UIStroke", ToastFrame)
    ToastStroke.Color = Theme.Accent
    ToastStroke.Thickness = 1.5

    local ToastLabel = Instance.new("TextLabel")
    ToastLabel.Size = UDim2.new(1, -20, 1, 0)
    ToastLabel.Position = UDim2.new(0, 10, 0, 0)
    ToastLabel.BackgroundTransparency = 1
    ToastLabel.TextColor3 = Theme.TextWhite
    ToastLabel.TextSize = 12
    ToastLabel.ZIndex = 101
    RegisterFont(ToastLabel, true)
    ToastLabel.Parent = ToastFrame

    local toastToken = 0
    local function ShowToast(msg)
        toastToken = toastToken + 1
        local myToken = toastToken
        ToastLabel.Text = msg
        local width = math.max(160, ToastLabel.TextBounds.X + 36)
        ToastFrame.Size = UDim2.new(0, width, 0, 32)
        Tween(ToastFrame, 0.25, { Position = UDim2.new(0.5, -width / 2, 1, -48) })
        task.delay(2, function()
            if toastToken == myToken then
                Tween(ToastFrame, 0.25, { Position = UDim2.new(0.5, -width / 2, 1, 50) })
            end
        end)
    end

    -- Главное окно
    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Size = UDim2.new(0, 520, 0, 340)
    MainFrame.Position = UDim2.new(UIState.MainWin.ScaleX, UIState.MainWin.OffsetX, UIState.MainWin.ScaleY, UIState.MainWin.OffsetY)
