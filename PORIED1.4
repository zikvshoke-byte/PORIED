            { Name = "RGB Rainbow", Color = nil, IsRainbow = true }
        }

        local activeThemeName = "Emerald Green"
        local savedTheme = LoadJSON("poried_theme.json")
        if savedTheme then
            if savedTheme.IsRainbow then
                activeThemeName = "RGB Rainbow"
            elseif savedTheme.ThemeName then
                activeThemeName = savedTheme.ThemeName
            end
        end

