        RegisterTranslatable(SecTheme, "ThemeSelector", "", true)

        local ThemesList = {
            { Name = "Emerald Green", Color = Color3.fromRGB(0, 230, 118) },
            { Name = "Neon Purple", Color = Color3.fromRGB(170, 0, 255) },
